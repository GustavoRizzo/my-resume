{
  "name": "my-resume",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:gh-pages": "DEPLOY_TARGET=gh-pages npm run build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare npm run build",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.0.6",
    "isomorphic-dompurify": "^4.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^3.2.1",
    "jsdom": "^31.0.1",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
