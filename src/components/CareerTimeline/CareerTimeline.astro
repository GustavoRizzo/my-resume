---
import "./style.scss";
import { LOCALE_BY_LANG, t, type Lang } from "../../i18n";
import { withBase } from "../../utils/withBase";

type Experience = {
  title: string;
  subtitle: string;
  text: string;
  company_logo: string;
  company_url?: string;
  initial_date: string;
};

interface Props {
  lang: Lang;
  experiences: Experience[];
  /** Heading level of the section title: 1 on its own page, 2 inside the home. */
  level?: 1 | 2;
}

const { lang, experiences, level = 1 } = Astro.props;
// Document structure decides the tags; the visual size comes from the classes.
const SectionHeading = `h${level}` as const;
const RoleHeading = level === 1 ? "h2" : "h3";
const locale = LOCALE_BY_LANG[lang];

// Dates are formatted at build time, per language ("JUN 2024" / "JUN. 2024").
const formattedDate = (str: string) => {
  const date = new Date(str);
  const month = date.toLocaleString(locale, { month: "short" }).toUpperCase();
  return `${month} ${date.getFullYear()}`;
};

const items = experiences.map((exp, index) => ({
  ...exp,
  date: formattedDate(exp.initial_date),
  // Logos live in public/; anchor them to the base so they load from any URL.
  logoUrl: withBase(exp.company_logo),
  delay: `${index * 200}ms`,
}));
---

<section class="career">
  <SectionHeading class="section-title">{t(lang, "sections.careerTimeline")}</SectionHeading>
  <div class="rb-container">
    <ul class="rb" data-reveal>
      {
        items.map((exp) => (
          <li class="rb-item" style={`--reveal-delay: ${exp.delay}`}>
            {exp.company_url ? (
              <a
                class="company-logo"
                style={`background-image: url(${exp.logoUrl})`}
                href={exp.company_url}
                aria-label={exp.subtitle}
                target="_blank"
                rel="noreferrer"
              />
            ) : (
              <div class="company-logo" style={`background-image: url(${exp.logoUrl})`} />
            )}
            <div class="paragraph">
              <time class="date-pill" datetime={exp.initial_date}>{exp.date}</time>
              <RoleHeading class="title">{exp.title}</RoleHeading>
              <div class="sub-title">
                {exp.company_url ? (
                  <a class="sub-title-link" href={exp.company_url} target="_blank" rel="noreferrer">
                    {exp.subtitle}
                  </a>
                ) : (
                  exp.subtitle
                )}
              </div>
              <div class="text">{exp.text}</div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../scripts/revealOnScroll";
  revealOnScroll("ul.rb[data-reveal]", 0.1);
</script>
