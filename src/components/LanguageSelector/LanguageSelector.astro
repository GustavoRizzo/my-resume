---
import "./style.scss";
import { LANG_NAME, SUPPORTED_LANGS, switchLangPath, t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Target URL for each language is computed at build time — switching language
// is a plain link, no client-side router involved. Links (not radios): they
// are focusable, announce their name, and only navigate on activation.
const options = SUPPORTED_LANGS.map((code) => ({
  code,
  name: LANG_NAME[code],
  current: code === lang,
  href: switchLangPath(Astro.url.pathname, code),
}));
---

<nav class="language-selector" aria-label={t(lang, "language.label")}>
  <ul class="language-selector__list">
    {
      options.map(({ code, name, current, href }) => (
        <li>
          <a
            class={`language-selector__flag ${code}-lang`}
            href={href}
            hreflang={code}
            lang={code}
            aria-label={name}
            aria-current={current ? "page" : undefined}
            data-lang={code}
          />
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Remember the choice (read by the "/" language redirect); the link navigates.
  document.querySelectorAll<HTMLAnchorElement>(".language-selector a[data-lang]").forEach((link) => {
    link.addEventListener("click", () => {
      window.localStorage.setItem("resume.lang", link.dataset.lang!);
    });
  });
</script>
