---
import "./style.scss";
import webIcon from "./icons/web.svg?raw";
import presentationIcon from "./icons/presentation.svg?raw";
import engineIcon from "./icons/engine.svg?raw";
import { sanitizeHtml } from "../../utils/sanitizeHtml";
import { t, type Lang } from "../../i18n";
import { withBase } from "../../utils/withBase";

type Expertise = {
  title: string;
  html_text: string;
  url_img: string;
  underline_class_css: string;
  code_tag?: string;
  icon?: string;
};

interface Props {
  lang: Lang;
  expertises: Expertise[];
  /** Heading level of the section title: 1 on its own page, 2 inside the home. */
  level?: 1 | 2;
}

const { lang, expertises, level = 1 } = Astro.props;
// Document structure decides the tags; the visual size comes from the classes.
const SectionHeading = `h${level}` as const;
const CardHeading = level === 1 ? "h2" : "h3";

// Map an icon key (from the content JSON) to the raw SVG markup of its file.
// To edit an icon, just change the corresponding file in ./icons/.
const ICONS: Record<string, string> = {
  web: webIcon,
  presentation: presentationIcon,
  engine: engineIcon,
};

// "Software Developer" → "software-developer.html" (the editor tab's file name).
const toFileName = (title: string) =>
  title
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "") + ".html";

// 'dl class="stack"' → { name: "dl", attrs: [{ name: "class", value: "stack" }] },
// so the fake tag can be syntax-highlighted (format validated in content.config).
const parseTag = (raw: string) => {
  const match = raw.trim().match(/^(\S+)\s*(.*)$/);
  const name = match?.[1] ?? "div";
  const rest = match?.[2] ?? "";
  const attrs = [...rest.matchAll(/([\w-]+)="([^"]*)"/g)].map(([, n, v]) => ({ name: n, value: v }));
  return { name, attrs };
};

const items = expertises.map((item, index) => {
  const [firstWord, ...rest] = item.title.split(" ");
  return {
    ...item,
    firstWord,
    restOfTitle: rest.join(" "),
    tag: parseTag(item.code_tag ?? "div"),
    fileName: toFileName(item.title),
    svg: item.icon ? ICONS[item.icon] : undefined,
    // Fallback icon path from content JSON is public/-relative; anchor it to the base.
    imgSrc: /^https?:/.test(item.url_img) ? item.url_img : withBase(item.url_img),
    delay: `${index * 150}ms`,
    cleanHtml: sanitizeHtml(item.html_text),
  };
});
---

<section class="expertise-v3">
  <SectionHeading class="section-title">{t(lang, "sections.myExpertise")}</SectionHeading>

  <div class="expertise-v3__grid" data-reveal>
    {
      items.map((item) => (
        <article class="expertise-v3__item" style={`--reveal-delay: ${item.delay}`}>
          {/* Each card parodies a code-editor window: a tab, a gutter, syntax colors. */}
          <div class="expertise-v3__tabs" aria-hidden="true">
            <span class="expertise-v3__tab">
              <span class="expertise-v3__tab-icon">&lt;/&gt;</span>
              {item.fileName}
              <span class="expertise-v3__tab-state" />
            </span>
          </div>

          <div class="expertise-v3__body">
          <div class="expertise-v3__headline">
            {/* Decorative: the heading next to it already names the card. */}
            <div class="expertise-v3__icon" aria-hidden="true">
              {item.svg ? <span set:html={item.svg} /> : <img src={item.imgSrc} alt="" />}
            </div>
            <CardHeading class="expertise-v3__name">
              <span class={`expertise-v3__underline ${item.underline_class_css}`}>{item.firstWord}</span>
              <br />
              {item.restOfTitle}
            </CardHeading>
          </div>

          <div class="expertise-v3__code">
            {/* The <tag> frame is decoration; screen readers skip it. */}
            <span class="expertise-v3__tag" aria-hidden="true">
              <span class="tok-punct">&lt;</span><span class="tok-tag">{item.tag.name}</span>
              {
                item.tag.attrs.map((attr) => (
                  <>
                    <span class="tok-attr">{attr.name}</span><span class="tok-punct">=</span><span class="tok-string">"{attr.value}"</span>
                  </>
                ))
              }
              <span class="tok-punct">&gt;</span>
            </span>
            <div class="expertise-v3__text" set:html={item.cleanHtml} />
            <span class="expertise-v3__tag" aria-hidden="true">
              <span class="tok-punct">&lt;/</span><span class="tok-tag">{item.tag.name}</span><span class="tok-punct">&gt;</span><span class="expertise-v3__caret" />
            </span>
          </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { revealOnScroll } from "../../scripts/revealOnScroll";
  import { setupBreakpoints } from "../../scripts/breakpoints";
  revealOnScroll(".expertise-v3__grid[data-reveal]", 0.2);
  setupBreakpoints();
</script>
