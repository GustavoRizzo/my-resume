---
import { Image } from "astro:assets";
import perfil from "../../assets/perfil.png";
import linkedinIcon from "../../assets/icons/linkedin.svg";
import githubIcon from "../../assets/icons/github.svg";
import easterEgg2 from "../../assets/perfil_easter_egg_2.webp";
import easterEgg3 from "../../assets/perfil_easter_egg_3.webp";
import type { About } from "../../types/About";
import "./style.scss";

// Hero: profile photo (with click easter egg), name, console typewriter and
// contact links. Static HTML + a small vanilla script (below) — no framework
// runtime on the first fold. The photo is the page's LCP element, hence the
// responsive WebP srcset, eager load and high fetch priority.

type Props = Omit<About, "perfil_img">;

const { name, url_linkedin, url_github, console_phrases } = Astro.props;

const easterEggFrames = [easterEgg2.src, easterEgg3.src];
---

<section class="about" data-who-am-i>
  <div class="about_perfil_wrap" data-easter-egg-frames={JSON.stringify(easterEggFrames)}>
    <Image
      class="about_img_perfil"
      src={perfil}
      alt={name}
      format="webp"
      widths={[400, 600, 800]}
      sizes="(max-width: 444px) 90vw, 400px"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    {/* Easter-egg hint: "click" twice around the photo, slowly rotating,
        fading in and out on a cycle (see style.scss). */}
    <svg class="about_click_hint" viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <path id="click-hint-circle" d="M 50,50 m -46,0 a 46,46 0 1,1 92,0 a 46,46 0 1,1 -92,0"></path>
      </defs>
      <text>
        <textPath href="#click-hint-circle" startOffset="0%">click</textPath>
        <textPath href="#click-hint-circle" startOffset="50%">click</textPath>
      </text>
    </svg>
  </div>
  <h1 class="hero-title">{name}</h1>
  <div class="console-container" data-console-phrases={JSON.stringify(console_phrases)}>
    <span id="console-text-id"></span>
    <div class="console-underscore hidden" id="console-cursor">▊</div>
  </div>
  <div class="list_contato">
    <a href={url_linkedin} aria-label="LinkedIn">
      <img class="linkedin" src={linkedinIcon.src} alt="" width="30" height="30" />
    </a>
    <a href={url_github} aria-label="GitHub">
      <img class="github" src={githubIcon.src} alt="" width="30" height="30" />
    </a>
  </div>
</section>

<script>
  import { startConsoleTyping } from "../../scripts/consoleTyping";
  import { setupEasterEgg } from "../../scripts/easterEgg";

  document.querySelectorAll<HTMLElement>("[data-who-am-i]").forEach((hero) => {
    const wrap = hero.querySelector<HTMLElement>("[data-easter-egg-frames]");
    const img = wrap?.querySelector("img");
    if (wrap && img) {
      const [frame2, frame3] = JSON.parse(wrap.dataset.easterEggFrames ?? "[]");
      if (frame2 && frame3) setupEasterEgg(wrap, img, [frame2, frame3]);
    }

    const consoleBox = hero.querySelector<HTMLElement>("[data-console-phrases]");
    const text = consoleBox?.querySelector<HTMLElement>("#console-text-id");
    const cursor = consoleBox?.querySelector<HTMLElement>("#console-cursor");
    if (consoleBox && text && cursor) {
      startConsoleTyping(text, cursor, JSON.parse(consoleBox.dataset.consolePhrases ?? "[]"));
    }
  });
</script>
