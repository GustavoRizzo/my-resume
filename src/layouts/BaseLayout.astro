---
import "../styles/global.scss";
import type { Lang } from "../i18n";
import { AUTHOR, pageSeo, type PageKey } from "../i18n/seo";
import { withBase } from "../utils/withBase";

interface Props {
  lang: Lang;
  page: PageKey;
  /** Sub-path under the language prefix, e.g. "" or "/career". */
  path: string;
}

const { lang, page, path } = Astro.props;
const seo = pageSeo(lang, page, path);
const favicon = withBase("favicon.svg");

// Google Tag Manager, deferred. The dataLayer and the gtm.start timestamp are
// set right away (so GTM still sees the real page start and any early pushes),
// but gtm.js itself (~300 KiB with GA4, the page's heaviest main-thread cost)
// is only fetched after `load`, when the browser is idle — keeping it off the
// critical path of the first paint / LCP.
const GTM = `(function (w, d, l, i) {
  w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
  function inject() {
    var j = d.createElement('script'); j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + (l != 'dataLayer' ? '&l=' + l : '');
    d.head.appendChild(j);
  }
  function schedule() {
    if ('requestIdleCallback' in w) w.requestIdleCallback(inject, { timeout: 3000 });
    else setTimeout(inject, 1500);
  }
  if (d.readyState === 'complete') schedule();
  else w.addEventListener('load', schedule, { once: true });
})(window, document, 'dataLayer', 'GTM-W6HR4FW5');`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content={AUTHOR} />
    {!seo.indexable && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.url} />
    <meta property="og:image" content={seo.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />
    <link rel="canonical" href={seo.url} />
    {seo.alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <script is:inline set:html={GTM} />
    <!-- Scroll-reveal sections start hidden and reveal via JS. Without JS,
         force them visible so the prerendered content stays readable. -->
    <noscript>
      <style>
        .expertise-v3__item,
        ul.rb li {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <div id="root">
      <div class="container">
        <slot />
      </div>
    </div>
  </body>
</html>
