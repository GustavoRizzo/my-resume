# Copy to `.env` (git-ignored) to deploy to Cloudflare from your machine:
#   cp .env.example .env    # then fill in the values
#   npm run build:cloudflare && npm run deploy:cloudflare
# Wrangler reads .env automatically. Without it, export the variables in the
# shell (`read -rsp ... CLOUDFLARE_API_TOKEN`) or use `npx wrangler login`.

# API token (Account API tokens or My Profile → API Tokens). Needs, on the
# account, Workers Scripts › Edit (Legacy; "Workers › Editor" alone can't upload
# assets) and, on the bygus.dev zone, Zone › Read + Workers Routes › Edit.
# SECRET: never commit it. In CI it lives in the repo secret of the same name.
CLOUDFLARE_API_TOKEN=

# Account ID: Workers & Pages overview (right sidebar). An identifier, not a secret.
CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# NOT set here, documented for reference:
# - DEPLOY_TARGET (gh-pages | cloudflare) and CANONICAL_TARGET are build
#   inputs set by the npm scripts (`build:gh-pages`, `build:cloudflare`) and by
#   the workflow. astro.config.mjs reads them from the process environment, so
#   values in this file would NOT reach the build.
# - DEPLOY_GH_PAGES / DEPLOY_CLOUDFLARE / CANONICAL_TARGET for CI are GitHub
#   repository *variables* (Settings → Secrets and variables → Actions), not env
#   files: `gh variable set <NAME> --body <value>`.
